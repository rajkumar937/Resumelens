# Copy to .env and fill in your values. Never commit .env to git.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=false
MAX_UPLOAD_BYTES=10485760
PORT=5000
TRUST_PROXY=true
# Optional: override where uploaded PDFs are temp-written (must be writable)
# UPLOAD_FOLDER=/tmp/resumelens-uploads
# Optional: override sqlite db path (point at a persistent disk in prod)
# DB_PATH=/var/data/resumelens.db
